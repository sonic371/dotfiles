#!/usr/bin/env bash
# with-secrets [-m MAPFILE] COMMAND [ARGS...]
# Run COMMAND with API keys from KeePassXC as environment variables, so they never sit in a .env file.
# Map file (default ~/.config/secrets/env.map), one per line:   VAR = Entry title : password|username
# Stops before running COMMAND if any mapped key can't be read.
set -euo pipefail
map=~/.config/secrets/env.map
if [[ ${1:-} == -m ]]; then map=$2; shift 2; fi
(( $# )) || { echo "usage: with-secrets [-m MAPFILE] COMMAND [ARGS...]" >&2; exit 2; }

while IFS= read -r line; do
    line=${line%%#*}
    [[ $line == *=* ]] || continue
    var=$(echo "${line%%=*}" | xargs)
    spec=${line#*=}
    title=$(echo "${spec%:*}" | xargs)
    field=$(echo "${spec##*:}" | xargs)
    value=$(get-secret "$title" "$field") || exit 1   # a plain `export VAR=$(...)` would hide the failure
    export "$var=$value"
done < "$map"

exec "$@"
