#!/usr/bin/env bash
# scanner [stop|status]: the phone's `scanner` setup on the PC.
# A separate Brave profile (~/.config/brave-trading; Brave refuses remote debugging on the default
# one) with a debug port on 127.0.0.1:9222 for stocktools' firewatch.py / movers.py, the DTS scanner
# window and TradeZero TZ1 (demo account only) in front, each an app window (no tabs or address
# bar). Pages already open are reused.
# You log in to both sites yourself. Port 9222 lets any local program drive this window: `scanner stop`
# when done (that also logs you out of DTS: its session cookie dies with the browser).
#
# PiP view extension (compact DTS + TZ1 views) comes from termux-kits kits/25-browser/files/pipview.
# Brave ignores --load-extension, so load it once by hand: brave://extensions, Developer mode,
# "Load unpacked", pick that folder. It stays in the profile.
set -u
PROFILE=$HOME/.config/brave-trading PORT=9222
DTS=https://daytradingstrategies.net/real-time-stock-scanner/
TZ1=https://tz1.tradezero.com/

up() { curl -s -m 2 "http://127.0.0.1:$PORT/json/version" >/dev/null; }

# id of the page already showing that site (any window), or nothing
page_id() {
    local host
    host=$(sed -E 's#^[a-z]+://([^/]+).*#\1#' <<<"$1")
    curl -s "http://127.0.0.1:$PORT/json/list" | jq -r --arg h "$host" \
        '[.[] | select(.type == "page" and (.url | contains($h)))][0].id // empty'
}

# bring that site's page to the front, or open it as an app window (no tabs, no address bar).
# A second `brave --app` with the same profile is handed to the running instance.
front() {
    local id
    id=$(page_id "$1")
    if [ -z "$id" ]; then
        brave --user-data-dir="$PROFILE" --app="$1" >/dev/null 2>&1 &
        for _ in $(seq 10); do id=$(page_id "$1"); [ -n "$id" ] && break; sleep 1; done
    fi
    [ -n "$id" ] && curl -s "http://127.0.0.1:$PORT/json/activate/$id" >/dev/null
}

case "${1:-}" in
stop)   pkill -f -- "--user-data-dir=$PROFILE" && echo stopped || echo "not running"; exit ;;
status) up && echo "running (port $PORT)" || echo "not running"; exit ;;
"")     ;;
*)      sed -n '2,12p' "$0"; exit 1 ;;
esac

if ! up; then
    # TZ: page clocks and news times in US Eastern, like the phone's browser kit.
    # --disable-*background*: keep the background DTS tab live (firewatch and the TZ1 view read it).
    # --autoplay-policy: DTS squawk can play without a click first.
    TZ=America/New_York nohup brave --user-data-dir="$PROFILE" \
        --remote-debugging-address=127.0.0.1 --remote-debugging-port=$PORT \
        --password-store=basic --no-first-run --no-default-browser-check \
        --disable-background-timer-throttling --disable-renderer-backgrounding \
        --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required \
        --app="$DTS" >/dev/null 2>&1 &
    for _ in $(seq 30); do up && break; sleep 1; done
    up || { echo "brave did not open port $PORT"; exit 1; }
fi
front "$DTS"
front "$TZ1"
echo "scanner ready: log in if a site asks; TZ1 is in front. Send the DTS window to tag 9 (Mod+Shift+9): TZ1 shows its list"
