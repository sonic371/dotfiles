#!/bin/bash
# Restart xidlehook after a display-profile change so it applies the right
# dim/suspend timers. autorandr runs as the user at login and as root on
# hotplug (udev -> autorandr.service); handle both.
if [ "$(id -u)" -eq 0 ]; then
    uid="$(loginctl list-users --no-legend 2>/dev/null | awk 'NR==1{print $1}')"
    [ -n "$uid" ] || exit 0
    XDG_RUNTIME_DIR="/run/user/$uid" systemctl --user try-restart xidlehook.service
else
    systemctl --user try-restart xidlehook.service
fi
