#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "rich>=13.0.0",
# ]
# ///
"""
record: screen recorder with an optional webcam overlay
=========================================================
A front end for `gpu-screen-recorder` (GPU encoding). Records the screen, the
webcam as a picture-in-picture corner, the microphone and system audio to
~/Videos/Recordings/YYYY-MM-DD HH-MM-SS.mp4 (OBS-style names).

  record            record with a live dashboard; Ctrl+C stops and saves
  record --toggle   for a hotkey: stop the running recording, or start one

Only one recording runs at a time. Without a terminal (e.g. from sxhkd), start
and failure are shown as notifications; the save notification comes from the
--save-script (record-saved.sh by default).
"""

import os
import sys
import re
import signal
import subprocess
import time
from datetime import datetime
import argparse
import shutil
from rich.console import Console
from rich.panel import Panel
from rich.live import Live
from rich.text import Text
from rich.table import Table

console = Console()

PID_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "record.pid")
LOG_DIR = os.path.expanduser("~/.cache/record")
LOG_PATH = os.path.join(LOG_DIR, "gsr.log")
STOP_TIMEOUT = 30  # seconds to let gpu-screen-recorder finish writing the file


def check_gsr():
    """Verify that gpu-screen-recorder is installed."""
    if not shutil.which("gpu-screen-recorder"):
        console.print("[bold red]Error: gpu-screen-recorder is not installed.[/bold red]")
        console.print("Install it with: sudo pacman -S gpu-screen-recorder")
        sys.exit(1)


def notify(title, body="", urgency="normal"):
    """Desktop notification; quietly does nothing if notify-send is missing."""
    try:
        subprocess.run(["notify-send", "-a", "record", "-u", urgency, title, body],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


def running_recorder_pid():
    """PID of a `record` that is currently recording, or None."""
    try:
        pid = int(open(PID_FILE).read().strip())
        cmdline = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
    except (OSError, ValueError):
        return None
    if pid != os.getpid() and any(os.path.basename(a) == b"record" for a in cmdline):
        return pid
    return None


def fmt_size(sz):
    if sz > 1024 * 1024:
        return f"{sz / (1024 * 1024):.2f} MB"
    if sz > 1024:
        return f"{sz / 1024:.1f} KB"
    return f"{sz} B"


def generate_dashboard(stats, config, recording=True, error_msg=None):
    """Render the dashboard UI using Rich."""
    status_text = Text()
    failed = not recording and error_msg is not None
    if recording:
        dot_color = "red" if int(time.time() * 2) % 2 == 0 else "black"
        status_text.append("● ", style=dot_color)
        status_text.append("RECORDING", style="bold red")
    elif failed:
        status_text.append("✗ ", style="bold red")
        status_text.append("RECORDING FAILED", style="bold red")
    else:
        status_text.append("■ ", style="bold green")
        status_text.append("STOPPED / SAVED", style="bold green")

    body = Table.grid(expand=True)
    body.add_column()
    body.add_row(Panel(status_text, expand=False, border_style="bold red" if (recording or failed) else "bold green"))

    sub_grid = Table.grid(expand=True, padding=(0, 2))
    sub_grid.add_column(ratio=1)
    sub_grid.add_column(ratio=1)

    stats_table = Table(title="Live Stats", show_header=True, header_style="bold magenta", expand=True)
    stats_table.add_column("Metric", style="dim")
    stats_table.add_column("Value", style="bold cyan")
    stats_table.add_row("Duration", stats.get("time", "00:00:00"))
    stats_table.add_row("File Size", stats.get("size", "0 B"))
    stats_table.add_row("FPS", stats.get("fps", "–"))
    stats_table.add_row("Engine", f"gpu-screen-recorder ({config.get('codec')})")

    config_table = Table(title="Devices & Config", show_header=True, header_style="bold green", expand=True)
    config_table.add_column("Option", style="dim")
    config_table.add_column("Value", style="yellow")

    out_file = config.get("output_file", "")
    if len(out_file) > 35:
        out_file = "..." + out_file[-32:]
    config_table.add_row("Output", out_file)
    config_table.add_row("FPS Target", f"{config.get('fps')} fps")
    config_table.add_row("Quality", config.get("quality", "very_high"))

    if config.get("use_webcam"):
        config_table.add_row("Webcam", f"{config.get('webcam_dev')}")
        config_table.add_row("PiP Position", f"{config.get('pip_position')} ({int(config.get('pip_scale')*100)}%)")
    else:
        config_table.add_row("Webcam", "[dim]Disabled[/dim]")

    if config.get("use_mic"):
        mic = config.get("mic_dev", "default_input")
        if len(mic) > 25: mic = "..." + mic[-22:]
        config_table.add_row("Microphone", mic)
    else:
        config_table.add_row("Microphone", "[dim]Disabled[/dim]")

    if config.get("use_sys_audio"):
        sys_aud = config.get("sys_audio_dev", "default_output")
        if len(sys_aud) > 25: sys_aud = "..." + sys_aud[-22:]
        config_table.add_row("System Audio", sys_aud)
    else:
        config_table.add_row("System Audio", "[dim]Disabled[/dim]")

    if config.get("save_script"):
        config_table.add_row("On Save", os.path.basename(config["save_script"]))
    else:
        config_table.add_row("On Save", "[dim]None[/dim]")

    sub_grid.add_row(stats_table, config_table)
    body.add_row(sub_grid)

    if recording:
        body.add_row(Text("\n[Ctrl+C] to stop recording safely.", style="bold yellow", justify="center"))

    if error_msg:
        body.add_row(Text(""))
        body.add_row(Panel(f"[bold red]Log Summary:[/bold red]\n{error_msg}", title="Error Log", border_style="bold red"))

    return Panel(body, title="[bold cyan]record[/bold cyan]", border_style="cyan")


def main():
    parser = argparse.ArgumentParser(
        description="Record the screen (plus webcam overlay and audio) with gpu-screen-recorder.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )

    parser.add_argument("--toggle", action="store_true", help="Stop the running recording if there is one, otherwise start recording (for a hotkey)")
    parser.add_argument("--screen-only", action="store_true", help="Record just the screen: no webcam, microphone or system audio")
    parser.add_argument("-o", "--output", help="Output file path (default: YYYY-MM-DD HH-MM-SS.mp4 in ~/Videos/Recordings)")
    parser.add_argument("-w", "--webcam-device", default="/dev/video0", help="Webcam device path")
    parser.add_argument("--no-webcam", action="store_true", help="Disable webcam Picture-in-Picture overlay")
    parser.add_argument("-f", "--fps", type=int, default=30, help="Frame rate to record (30 or 60)")
    parser.add_argument("-q", "--quality", choices=["ultra", "very_high", "high", "medium", "low"], default="very_high", help="Recording quality profile")
    parser.add_argument("-k", "--codec", choices=["auto", "h264", "hevc", "av1"], default="h264", help="Video codec")

    parser.add_argument("-m", "--mic-device", default="default_input", help="Microphone audio device")
    parser.add_argument("--no-mic", action="store_true", help="Disable microphone audio recording")
    parser.add_argument("--no-system-audio", action="store_true", help="Disable system (desktop) audio recording")
    parser.add_argument("-sa", "--system-audio-device", default="default_output", help="System output audio device")

    parser.add_argument("-p", "--pip-position", choices=["bottom-right", "bottom-left", "top-right", "top-left"], default="bottom-left", help="Webcam overlay corner")
    parser.add_argument("--pip-scale", type=float, default=0.20, help="Webcam overlay width scale relative to screen width (0.1 to 0.5)")

    parser.add_argument("--save-script", default="~/.config/scripts/record-saved.sh", help="Script gpu-screen-recorder runs after saving (gets file path and type)")
    parser.add_argument("--no-save-script", action="store_true", help="Don't run a script after saving")

    args = parser.parse_args()

    if args.screen_only:
        args.no_webcam = args.no_mic = args.no_system_audio = True

    # Without a terminal (hotkey), the dashboard is invisible: use notifications
    use_notify = args.toggle or not sys.stdout.isatty()

    # One recording at a time. --toggle stops the running one instead.
    other = running_recorder_pid()
    if other:
        if args.toggle:
            os.kill(other, signal.SIGINT)
            return
        console.print(f"[bold red]A recording is already running (pid {other}).[/bold red] Stop it first, or use record --toggle.")
        sys.exit(1)

    check_gsr()

    # Script to run once the file is saved (gpu-screen-recorder -sc)
    save_script = None
    if not args.no_save_script and args.save_script:
        save_script = os.path.abspath(os.path.expanduser(args.save_script))
        if not os.access(save_script, os.X_OK):
            console.print(f"[yellow]Warning: save script {save_script} is missing or not executable. Skipping it.[/yellow]")
            save_script = None

    # Setup Output File
    if args.output:
        output_file = os.path.abspath(args.output)
    else:
        recordings_dir = os.path.expanduser("~/Videos/Recordings")
        os.makedirs(recordings_dir, exist_ok=True)
        timestamp = datetime.now().strftime("%Y-%m-%d %H-%M-%S")
        output_file = os.path.join(recordings_dir, f"{timestamp}.mp4")

    # Determine webcam usage
    use_webcam = not args.no_webcam
    webcam_dev = args.webcam_device
    if use_webcam and not os.path.exists(webcam_dev):
        console.print(f"[yellow]Warning: Webcam device {webcam_dev} not found. Disabling webcam overlay.[/yellow]")
        use_webcam = False

    # Position maps using official gpu-screen-recorder syntax
    scale_pct = int(args.pip_scale * 100)
    pos_map = {
        "bottom-right": f"halign=end;valign=end;width={scale_pct}%;height={scale_pct}%;hflip=true",
        "bottom-left":  f"halign=start;valign=end;width={scale_pct}%;height={scale_pct}%;hflip=true",
        "top-right":    f"halign=end;valign=start;width={scale_pct}%;height={scale_pct}%;hflip=true",
        "top-left":     f"halign=start;valign=start;width={scale_pct}%;height={scale_pct}%;hflip=true",
    }

    if use_webcam:
        pip_opts = pos_map[args.pip_position]
        capture_src = f"screen|{webcam_dev};{pip_opts}"
    else:
        capture_src = "screen"

    # Audio inputs
    audio_inputs = []
    use_mic = not args.no_mic
    use_sys_audio = not args.no_system_audio

    if use_mic and args.mic_device:
        audio_inputs.append(args.mic_device)
    if use_sys_audio and args.system_audio_device:
        audio_inputs.append(args.system_audio_device)

    # Command construction
    cmd = [
        "gpu-screen-recorder",
        "-w", capture_src,
        "-f", str(args.fps),
        "-q", args.quality,
        "-k", args.codec,
        "-o", output_file
    ]

    if audio_inputs:
        cmd.extend(["-a", "|".join(audio_inputs)])

    if save_script:
        cmd.extend(["-sc", save_script])

    config_info = {
        "output_file": output_file,
        "fps": args.fps,
        "quality": args.quality,
        "codec": args.codec,
        "use_webcam": use_webcam,
        "webcam_dev": webcam_dev,
        "pip_position": args.pip_position,
        "pip_scale": args.pip_scale,
        "use_mic": use_mic,
        "mic_dev": args.mic_device if use_mic else None,
        "use_sys_audio": use_sys_audio,
        "sys_audio_dev": args.system_audio_device if use_sys_audio else None,
        "save_script": save_script,
    }

    stats = {"fps": "–", "size": "0 B", "time": "00:00:00"}

    # gpu-screen-recorder logs to a file; we read it back for the real FPS
    os.makedirs(LOG_DIR, exist_ok=True)
    log_file_handle = open(LOG_PATH, "w")
    process = subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=log_file_handle,
        stderr=log_file_handle,
    )
    log_reader = open(LOG_PATH, "r", errors="replace")
    fps_re = re.compile(r"update fps: (\d+)")

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    start_time = time.time()
    # Set when we ask the recorder to stop (Ctrl+C / SIGTERM / record --toggle).
    # If the recorder exits without being asked, it failed: it only stops when told to.
    stop_requested = False
    force_killed = False

    def stop_gsr():
        nonlocal force_killed
        if process.poll() is None:
            try:
                process.send_signal(signal.SIGINT)
                process.wait(timeout=STOP_TIMEOUT)
            except Exception:
                try:
                    process.kill()
                    process.wait()
                    force_killed = True
                except Exception:
                    pass

    def cleanup_handler(sig, frame):
        nonlocal stop_requested
        stop_requested = True
        stop_gsr()

    signal.signal(signal.SIGINT, cleanup_handler)
    signal.signal(signal.SIGTERM, cleanup_handler)

    # A bad device or encoder makes gpu-screen-recorder quit within a moment;
    # only announce the start once it has survived that.
    for _ in range(10):
        if process.poll() is not None:
            break
        time.sleep(0.1)
    if use_notify and process.poll() is None:
        notify("Recording started", os.path.basename(output_file) + "\nRun record --toggle again to stop.")

    try:
        with Live(generate_dashboard(stats, config_info, recording=True), refresh_per_second=2, auto_refresh=True) as live:
            while True:
                if process.poll() is not None:
                    break

                elapsed = int(time.time() - start_time)
                m, s = divmod(elapsed, 60)
                h, m = divmod(m, 60)
                stats["time"] = f"{h:02d}:{m:02d}:{s:02d}"

                for line in log_reader.readlines():
                    match = fps_re.search(line)
                    if match:
                        stats["fps"] = match.group(1)

                if os.path.exists(output_file):
                    stats["size"] = fmt_size(os.path.getsize(output_file))

                live.update(generate_dashboard(stats, config_info, recording=True))
                time.sleep(0.5)

    except Exception as e:
        console.print(f"[bold red]Recorder error: {e}[/bold red]")
    finally:
        stop_gsr()
        log_file_handle.close()
        log_reader.close()
        try:
            if open(PID_FILE).read().strip() == str(os.getpid()):
                os.remove(PID_FILE)
        except OSError:
            pass

        # Work out whether this run actually produced a recording
        problem = None
        if not stop_requested:
            problem = f"gpu-screen-recorder quit on its own (exit code {process.returncode})."
        elif force_killed:
            problem = f"gpu-screen-recorder did not finish within {STOP_TIMEOUT} s and was force-stopped; the end of the recording may be missing."
        elif process.returncode not in (0, None):
            problem = f"gpu-screen-recorder did not stop cleanly (exit code {process.returncode})."

        size = os.path.getsize(output_file) if os.path.exists(output_file) else 0
        stats["size"] = fmt_size(size)  # the file is finalised on stop, so refresh it
        if size == 0 and problem is None:
            problem = "No video data was written."

        error_msg = None
        if problem:
            try:
                with open(LOG_PATH) as f:
                    tail = "".join(f.readlines()[-15:]).strip()
            except OSError:
                tail = ""
            error_msg = problem + (f"\n\n{tail}" if tail else "") + f"\n\nFull log: {LOG_PATH}"

        console.print(generate_dashboard(stats, config_info, recording=False, error_msg=error_msg))

        if size > 0:
            if problem:
                console.print(f"\n[bold yellow]! A file was written but may be incomplete:[/bold yellow] [yellow]{output_file}[/yellow] ({fmt_size(size)})")
            else:
                console.print(f"\n[bold green]✓ Recording saved successfully to:[/bold green] [yellow]{output_file}[/yellow] ({fmt_size(size)})")
        else:
            if os.path.exists(output_file):
                os.remove(output_file)  # empty file, nothing worth keeping
            console.print("\n[bold red]✗ No recording was saved.[/bold red]")

        if problem:
            if use_notify:
                notify("Recording failed", f"{problem}\nLog: {LOG_PATH}", urgency="critical")
            sys.exit(1)


if __name__ == "__main__":
    main()
