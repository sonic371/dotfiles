#!/bin/sh
DEVICE="Wacom Intuos BT S Pen stylus"

# Check if the device exists
if ! xsetwacom --list devices | grep -qF "$DEVICE"; then
    notify-send -u critical "Wacom Script Error" "Wacom device not found"
    echo "Error: Wacom device not found" >&2
    exit 1
fi

# Get the actual current button mapping from the device
CURRENT_BUTTON=$(xsetwacom --get "$DEVICE" Button 2) || exit 1

# Button mode reports "button +2"; anything else (empty or "pan") is pan mode
case "$CURRENT_BUTTON" in
    *"button +2"*)
        xsetwacom --set "$DEVICE" PanScrollThreshold 200 &&
        xsetwacom --set "$DEVICE" Button 2 "pan" &&
        notify-send -t 2000 "Wacom Mode" "Pan mode" ;;
    *)
        xsetwacom --set "$DEVICE" Button 2 "button +2" &&
        notify-send -t 2000 "Wacom Mode" "Button mode" ;;
esac
