[Unit]
Description=XSS lock daemon — lock screen on suspend/lid-close
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/xss-lock --ignore-xss --transfer-sleep-lock --session=1 -- /usr/local/bin/slock
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
