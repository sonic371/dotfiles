#!/usr/bin/env sh

# Get battery info from upower
battery_info=$(upower -i /org/freedesktop/UPower/devices/battery_BAT0 2>/dev/null)

if [ -z "$battery_info" ]; then
    echo "󱊣 ?%"
    exit 1
fi

# Extract values
percentage=$(echo "$battery_info" | grep "percentage:" | awk '{print $2}' | tr -d '%')
state=$(echo "$battery_info" | grep "state:" | awk '{print $2}')
time_to_empty=$(echo "$battery_info" | grep "time to empty:" | awk '{print $4, $5}')
time_to_full=$(echo "$battery_info" | grep "time to full:" | awk '{print $4, $5}')

# Set icon and output
case "$state" in
    "discharging")
        if [ "$percentage" -lt 20 ]; then
            icon="󰂎"
        elif [ "$percentage" -lt 40 ]; then
            icon="󱊡"
        elif [ "$percentage" -lt 60 ]; then
            icon="󱊢"
        else
            icon="󱊣"
        fi
        if [ -n "$time_to_empty" ] && [ "$time_to_empty" != "0.00" ]; then
            echo "$icon $percentage% ($time_to_empty)"
        else
            echo "$icon $percentage%"
        fi
        ;;
    "charging")
        if [ -n "$time_to_full" ] && [ "$time_to_full" != "0.00" ]; then
            echo "󱐋 $percentage% ($time_to_full)"
        else
            echo "󱐋 $percentage%"
        fi
        ;;
    "fully-charged")
        echo "󱊣 $percentage% (Full)"
        ;;
    *)
        echo "󱊣 $percentage%"
        ;;
esac
