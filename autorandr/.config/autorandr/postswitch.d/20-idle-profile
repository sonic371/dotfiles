#!/bin/bash
# Restart xidlehook after a display-profile change so it applies the right
# dim/suspend timers. autorandr --batch (hotplug) runs hooks as the session
# user; a manual root run has no user manager to reach, so skip it.
[ "$(id -u)" -eq 0 ] && exit 0
systemctl --user try-restart xidlehook.service
