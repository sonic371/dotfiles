# ── Volume, mic, brightness ─────────────────────────────────
XF86AudioMute
	~/.config/scripts/sxhkd-volume.sh mute

XF86AudioLowerVolume
	~/.config/scripts/sxhkd-volume.sh down

XF86AudioRaiseVolume
	~/.config/scripts/sxhkd-volume.sh up

XF86AudioMicMute
	~/.config/scripts/sxhkd-toggle-mic.sh

XF86MonBrightnessDown
	~/.config/scripts/sxhkd-brightness.sh down

XF86MonBrightnessUp
	~/.config/scripts/sxhkd-brightness.sh up

# ── Screenshots (Print: select area, shift+Print: full screen) ─
@Print
	~/.config/scripts/sxhkd-maim.sh >/dev/null 2>&1

shift + @Print
	~/.config/scripts/sxhkd-maim.sh --full >/dev/null 2>&1

# ── Launchers ───────────────────────────────────────────────
super + Return
	st

# Dictionary: define the selected word
super + s
	~/.config/scripts/dmenu_define.sh

super + y
	~/.config/scripts/dmenu_media.sh

# Show the webcam in a window
super + w
	~/.config/scripts/record-webcam.sh

# Screen recording: start, or stop and save (notifications show the state)
# super+r: screen + webcam + mic + system audio; super+shift+r: screen only
super + r
	record --toggle >/dev/null 2>&1

super + shift + r
	record --toggle --screen-only >/dev/null 2>&1

# Toggle screen layout (laptop-only / laptop-manga)
super + v
	~/.config/scripts/sxhkd-toggle-rotate.sh

# ── ThinkPad keys ───────────────────────────────────────────
XF86Display
	~/.local/bin/tool-redshift-toggle >/dev/null 2>&1

XF86Favorites
	~/.local/bin/tool-middle-button-toggle >/dev/null 2>&1

# ── Model B1 remote ─────────────────────────────────────────
# Prev/Next: scroll up/down
XF86AudioPrev
	xdotool click --repeat 3 4

XF86AudioNext
	xdotool click --repeat 3 5

XF86AudioPlay
	playerctl play-pause

# Back/Home: zoom in/out
XF86Back
	xdotool key ctrl+plus

XF86HomePage
	xdotool key ctrl+minus

# Mail/WWW: volume up/down
XF86Mail
	~/.config/scripts/sxhkd-volume.sh up

XF86WWW
	~/.config/scripts/sxhkd-volume.sh down
