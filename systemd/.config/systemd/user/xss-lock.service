[Unit]
Description=XSS lock daemon — lock screen on suspend/lid-close
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/xss-lock --ignore-xss --transfer-sleep-lock --session=${XDG_SESSION_ID} -- %h/.config/scripts/slock.sh
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
