#!/bin/sh
# Signal the statusbar's bluetooth block whenever the adapter is powered on/off
# or a device connects/disconnects.

dbus-monitor --system "type='signal',sender='org.bluez',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged'" 2>/dev/null |
    while read -r line; do
        case "$line" in
            *'string "Powered"'* | *'string "Connected"'*)
                kill -37 $(pidof dwmblocks) 2>/dev/null ;;
        esac
    done
