#!/bin/bash
# List desktop applications for dmenu_run_cus, or print the command for one.
#   dmenu_desktop_cus          rebuild the cache and print app names
#   dmenu_desktop_cus "Name"   print the command to run for that app (from the cache)

cachedir="${XDG_CACHE_HOME:-"$HOME/.cache"}"
cache_file="$cachedir/dmenu_desktop_cache"
terminal="st -e"

[[ ! -e "$cachedir" ]] && mkdir -p "$cachedir"

# If no arguments are passed, it means we should list the applications
if [[ $# -eq 0 ]]; then
    > "$cache_file" # Clear the cache file

    # Process all desktop files
    while IFS= read -r -d '' desktop_file; do
        local_name=""
        local_exec=""
        in_entry=0
        hidden=0
        in_terminal=0

        # Read only the [Desktop Entry] section (actions like "New Window" come after it)
        while IFS= read -r line; do
            if [[ "$line" == "["* ]]; then
                [[ "$line" == "[Desktop Entry]" ]] && { in_entry=1; continue; }
                (( in_entry )) && break
                continue
            fi
            (( in_entry )) || continue

            case "$line" in
                Name=*)               [[ -z "$local_name" ]] && local_name="${line#Name=}" ;;
                Exec=*)               [[ -z "$local_exec" ]] && local_exec="${line#Exec=}" ;;
                NoDisplay=true|Hidden=true) hidden=1 ;;
                Terminal=true)        in_terminal=1 ;;
            esac
        done < "$desktop_file"

        # Skip entries meant to stay out of menus (file-type helpers, settings stubs, ...)
        (( hidden )) && continue
        [[ -z "$local_name" || -z "$local_exec" ]] && continue

        # Remove % arguments (space + % + any character)
        local_exec="${local_exec// %?/ }"
        # Terminal apps (btop, nvim, yazi, ...) need a terminal to show up in
        (( in_terminal )) && local_exec="$terminal $local_exec"

        echo "${local_name}|${local_exec}" >> "$cache_file"
    done < <(find -L /usr/share/applications ~/.local/share/applications -name "*.desktop" -print0 2>/dev/null)

    # Output unique names for dmenu display
    if [[ -s "$cache_file" ]]; then
        while IFS='|' read -r name _; do
            echo "$name"
        done < "$cache_file" | sort -u
    fi
else
    # An argument was passed, it's the selected name, so lookup and output the Exec command
    selected_name="$1"
    if [[ -n "$selected_name" && -s "$cache_file" ]]; then
        while IFS='|' read -r name exec_cmd; do
            if [[ "$name" == "$selected_name" ]]; then
                echo "$exec_cmd"
                break
            fi
        done < "$cache_file"
    fi
fi
