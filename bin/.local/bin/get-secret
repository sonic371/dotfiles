#!/usr/bin/env bash
# get-secret TITLE [password|username]
# Print one field of a KeePassXC entry, read through the Secret Service (secret-tool).
# KeePassXC must be running with the database unlocked; only the exposed group is visible.
set -euo pipefail
title=${1:?usage: get-secret TITLE [password|username]}
field=${2:-password}
case $field in
    password) value=$(secret-tool lookup Title "$title" 2>/dev/null || true) ;;
    # secret-tool prints the attribute lines on stderr
    username) value=$(secret-tool search Title "$title" 2>&1 | sed -n 's/^attribute\.UserName = //p' | head -n 1) ;;
    *) echo "get-secret: field must be password or username" >&2; exit 2 ;;
esac
if [[ -z $value ]]; then
    echo "get-secret: no $field for '$title' (is KeePassXC unlocked and the entry in the exposed group?)" >&2
    exit 1
fi
printf '%s' "$value"
